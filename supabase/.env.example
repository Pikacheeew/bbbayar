# Payment settings for the create-payment / check-payment edge functions.
# Live values are Supabase secrets (BarengPRO → Edge Functions → Secrets).
# To set them from a file: copy this to supabase/.env (git-ignored), fill it in, then run
#   npx supabase secrets set --env-file supabase/.env --project-ref dgzxzbhoehbdvajmpzqm
# Never commit real values.

# Text inside the merchant's printed static QRIS (starts with 000201). Decides which account receives the money.
STATIC_QRIS=

# ShopeePay merchant portal session token, starts with "B:". Portal → F12 → Network →
# get-transaction-list → Payload → token. Expires: replace it when payments stop confirming.
SHOPEE_TOKEN=

# ShopeePay portal transaction-list endpoint.
SHOPEE_LIST_URL=https://shopeepay.shopee.co.id/merchant/v1/partner-web/get-transaction-list
